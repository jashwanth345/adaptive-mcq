# Phase 3 configuration template. Copy to .env in the project root and supply secrets.
# The backend reads .env; process environment variables take precedence.
# No secrets are supplied. Blank required credentials fail startup.
APP_ENV=local
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# Existing local database and restricted runtime login; no auto-creation or migration.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=adaptive_mcq
DATABASE_USER=adaptive_mcq_app
DATABASE_PASSWORD=
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
AUTH_WINDOW_SECONDS=900
AUTH_LOGIN_ACCOUNT_LIMIT=5
AUTH_LOGIN_IP_LIMIT=30
AUTH_REGISTER_IP_LIMIT=5
DATABASE_POOL_SIZE=2
DATABASE_POOL_TIMEOUT_SECONDS=2
DATABASE_CONNECT_TIMEOUT_SECONDS=3
DATABASE_STATEMENT_TIMEOUT_MS=2000

# Test drafts work without LLM inference. No automatic fallback between modes.
GENERATOR_MODE=mock
VERIFIER_MODE=mock
LOCAL_ONLY=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
MODEL_SELECTION_STATUS=pending_hardware_validation
# Candidate checkpoints, NOT confirmed installed or quality validated.
GENERATOR_MODEL=qwen2.5:0.5b-instruct-q4_K_M
# Same small checkpoint candidate for separate role calls, NOT independent models.
VERIFIER_MODEL=qwen2.5:0.5b-instruct-q4_K_M
LLM_CONTEXT_TOKENS=2048
LLM_OUTPUT_TOKENS=512
LLM_MAX_CONCURRENT_JOBS=1
LLM_MAX_REGENERATIONS=2
RAG_TOP_K=3
# Provisional retrieval defaults; evaluate before claiming quality.
RAG_MIN_SIMILARITY=0.25
RAG_CONTEXT_CHARS=2400
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
UPLOAD_DIRECTORY=backend/uploads
DEFAULT_LANGUAGE=en

# These settings belong to the separately launched OLLAMA PROCESS.
# A project .env file does not automatically configure a running Ollama app.
# Future startup tooling must pass settings explicitly and verify local-only mode.
OLLAMA_HOST=127.0.0.1:11434
OLLAMA_NO_CLOUD=1

# No cloud URLs, API keys, automatic provider fallback or package auto-downloads.
# Model digests remain pending. Installed backend package versions are pinned in backend/requirements.txt.

# Review priority only; complaints never automatically confirm a defect.
FEEDBACK_MIN_REPORTERS=3
FEEDBACK_REPORT_RATIO=0.2
